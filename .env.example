# Copy to .env.local. Leave empty to run in demo mode (no database).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://pawverdi.com

# Set true only after confirming the operator's current Amazon Associates approval.
PAWVERDI_AMAZON_APPROVED=false
# Optional. Name an IP header your hosting edge overwrites on every request.
PAWVERDI_TRUSTED_IP_HEADER=
